# Model for `npm run chat`. The offline demo does not read credentials or call a model.
NPC_MODEL_ENDPOINT=
NPC_MODEL_NAME=
NPC_MODEL_API_KEY=
# disabled | low | high | max (default high)
NPC_MODEL_THINKING=
# Defaults: 60000 ms, 4000 tokens including reasoning
NPC_MODEL_TIMEOUT_MS=
NPC_MODEL_MAX_TOKENS=
# Companion robot (docs/companion-device.md §12.1). Without DASHSCOPE_API_KEY the robot can only be typed to.
DASHSCOPE_API_KEY=
# Defaults: wss://dashscope.aliyuncs.com/api-ws/v1/inference, paraformer-realtime-v2, cosyvoice-v3-flash
DASHSCOPE_WS_URL=
DASHSCOPE_ASR_MODEL=
DASHSCOPE_TTS_MODEL=
DASHSCOPE_VOCABULARY_ID=
# Defaults: 700 ms of silence ends a sentence, reasoning low for the robot, device port 47712
NPC_VOICE_SILENCE_MS=
NPC_VOICE_THINKING=
NPC_DEVICE_PORT=

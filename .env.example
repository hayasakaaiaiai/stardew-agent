# Model for `npm run bridge` and `npm run chat`; offline tests and demos need no credentials.
NPC_MODEL_ENDPOINT=
NPC_MODEL_NAME=
NPC_MODEL_API_KEY=
# disabled | low | high | max (default high)
NPC_MODEL_THINKING=
# Defaults: 60000 ms, 4000 tokens including reasoning
# Leave blank to use the defaults, or set a positive integer.
NPC_MODEL_TIMEOUT_MS=
NPC_MODEL_MAX_TOKENS=
# Optional game bridge port (default 47711); set BackendUrl in the Mod config to the same port.
# NPC_BRIDGE_PORT=47711

{
  "name": "stardew-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A lightweight Cordis runtime for concurrently active Stardew Valley NPCs.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "demo": "node src/demo.ts",
    "demo:built": "node dist/demo.js",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "build": "tsc"
  },
  "dependencies": {
    "@node-rs/jieba": "2.0.4",
    "cordis": "4.0.0-rc.11"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3"
  }
}
